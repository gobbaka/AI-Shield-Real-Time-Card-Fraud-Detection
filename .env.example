# ==============================================================================
# AI SHIELD - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure credentials for your local environment:
#   copy .env.example .env
# ==============================================================================

# SMS Provider Selection
# Options: auto (default) | fast2sms | twilio | mock
SMS_PROVIDER=auto

# Fast2SMS Configuration (India)
# Sign up at https://www.fast2sms.com -> Dev API -> Authorization API Key
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_ROUTE=q
FAST2SMS_OTP_ID=

# Twilio Configuration (International)
# Sign up at https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_PHONE=+15005550006

# Application Security & Cryptographic Keys
# JWT Signing Key (256-bit hex secret for production)
JWT_SECRET=your_custom_jwt_secret_hex_here

# PCI-DSS Database Vault Key for 256-bit AES PAN Encryption
AISHIELD_VAULT_KEY=your_custom_256bit_vault_key_here

# Database Configuration (for Docker / Production PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-db:5432/aishield_fraud_db
SPRING_DATASOURCE_USERNAME=aishield_admin
SPRING_DATASOURCE_PASSWORD=your_secure_password_here
POSTGRES_DB=aishield_fraud_db
POSTGRES_USER=aishield_admin
POSTGRES_PASSWORD=your_secure_password_here
